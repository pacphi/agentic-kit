{
  "name": "@pacphi/agentic-kit",
  "version": "4.0.0-alpha.61",
  "description": "Setup, healing, verification, and multi-host execution routing (Claude, Codex, OpenCode) for your AI agent stack (ruflo/claude-flow, agentic-qe, RuvNet Brain) — cross-platform, zero-dependency",
  "type": "module",
  "bin": {
    "agentic-kit": "bin/agentic-kit.mjs",
    "ak": "bin/agentic-kit.mjs"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=23.4.0"
  },
  "files": [
    "bin/agentic-kit.mjs",
    "src/",
    "!src/**/.claude/**",
    "!src/**/.agentic-qe/**",
    "!src/**/.claude-flow/**",
    "claude/",
    "!claude/**/.claude/**",
    "!claude/**/.agentic-qe/**",
    "!claude/**/.claude-flow/**",
    "docs/dashboard.md",
    "docs/host-support.md",
    "docs/hooks.md",
    "docs/installation.md",
    "docs/maintenance.md",
    "docs/models.md",
    "docs/telemetry.md",
    "docs/providers.md",
    "docs/setup.md",
    "docs/aqe-embeddings.md",
    "docs/troubleshooting.md",
    "docs/upgrading.md",
    "docs/codex-statusline.md",
    "docs/adr/0015-managed-codex-native-statusline.md",
    "docs/adr/0032-model-lifecycle-intelligence.md",
    "docs/adr/0033-retire-codex-mcp-and-bound-qe-court-participants.md",
    "docs/adr/0043-managed-ruflo-browser-executor.md",
    "docs/adr/0044-receipt-aware-maintenance-control-plane.md",
    "docs/adr/0051-supported-peer-delegation-and-host-realignment.md",
    "docs/adr/0054-fleet-evidence-export.md",
    "docs/adr/0055-aqe-embedding-lifecycle.md",
    "tests/live/aqe-external-provider-transport.test.mjs",
    "tests/live/aqe-stop-hook-conformance.test.mjs",
    "tests/live/aqe-codex-guidance-conformance.test.mjs",
    "tests/live/qe-court-participant-transport.test.mjs",
    "tests/live/disposable-memory-project.mjs",
    "tests/live/codex-context-contract.test.mjs",
    "docs/ddd/maintenance.md",
    "docs/ddd/model-lifecycle-intelligence.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs unit",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:quality": "node scripts/run-tests.mjs focus tests/quality/comment-label-guard.test.mjs",
    "test:surface": "node --test tests/kit/dispatch-surface.test.mjs",
    "test:aqe-external-provider-live": "node --test tests/live/aqe-external-provider-transport.test.mjs",
    "test:aqe-stop-hook-live": "AK_AQE_CONFORMANCE=1 node --test tests/live/aqe-stop-hook-conformance.test.mjs",
    "test:aqe-codex-guidance-live": "AK_AQE_CONFORMANCE=1 node --test tests/live/aqe-codex-guidance-conformance.test.mjs",
    "test:qe-court-live": "node --test tests/live/qe-court-participant-transport.test.mjs",
    "test:ruflo-memory-live": "node --test tests/live/ruflo-memory-routing.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:cc": "eslint src bin --rule 'complexity: [2, 50]'",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint README.md CLAUDE.md AGENTS.md \"docker/*.md\" \"claude/**/*.md\" \"src/templates/**/*.md\" \"docs/**/*.md\" \".claude/skills/akm-*/SKILL.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint README.md CLAUDE.md AGENTS.md \"docker/*.md\" \"claude/**/*.md\" \"src/templates/**/*.md\" \"docs/**/*.md\" \".claude/skills/akm-*/SKILL.md\" --ignore node_modules --fix",
    "lint:links": "lychee --config lychee.toml README.md CLAUDE.md AGENTS.md 'docker/*.md' 'claude/**/*.md' 'src/templates/**/*.md' 'docs/**/*.md' 'docs/**/*.html'",
    "lint:links:internal": "lychee --offline --include-fragments --config lychee.toml README.md CLAUDE.md AGENTS.md 'docker/*.md' 'claude/**/*.md' 'src/templates/**/*.md' 'docs/**/*.md' 'docs/**/*.html'",
    "build": "node scripts/build-check.mjs",
    "benchmark:footprint": "node scripts/benchmark-footprint.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix=override",
    "outdated": "pnpm outdated",
    "upgrade": "pnpm up",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:cc && pnpm run lint:md && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "markdownlint-cli": "^0.49.1",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pacphi/agentic-kit.git"
  },
  "license": "MIT",
  "keywords": [
    "ruflo",
    "claude-flow",
    "agentic-qe",
    "claude-code",
    "setup",
    "cross-platform"
  ],
  "packageManager": "pnpm@11.17.0"
}
