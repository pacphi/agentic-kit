# macOS
.DS_Store

# Editor / IDE
*.swp
*~
.vscode/
.idea/

# Backups created by install.sh / uninstall.sh / the helpers
*.bak
*.bak.*

# Local shell/env overrides
.env
.env.*

# Test scratch (ruflo-parity-test writes to /tmp, but guard against stray copies)
test-*.log
.swarm/
.claude-flow/

# Dogfooding artifacts — running ruflo init / aqe init / ruflo-onboard against THIS
# repo writes these. They are NOT source (see CLAUDE.md "Dogfooding artifacts are not
# source"); never commit them. The authored instruction files (CLAUDE.md for claude,
# AGENTS.md for codex) ARE tracked; only their generated dirs (.claude/, .agents/) and
# local overrides (.codex/) are ignored. The authored maintainer skills are the exception:
# each is listed by name below for both hosts, the same names as AUTHORED_SKILLS in
# scripts/skills-mirror.mjs (docs/maintainer.md, "Maintainer skills"). Any unlisted folder, a
# generated `managed-tools` skill included, stays ignored.
.agentic-qe/
.ruvnet-brain/
.harness/
**/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ak-docs-gate/
!/.claude/skills/ak-pricing-refresh/
!/.claude/skills/ak-release/
!/.claude/skills/ak-resume/
!/.claude/skills/ak-ship/
!/.claude/skills/ak-upstream-file/
!/.claude/skills/ak-upstream-status/
!/.claude/skills/ak-verify/
!/.claude/skills/ak-worktree-sweep/
**/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/ak-docs-gate/
!/.agents/skills/ak-pricing-refresh/
!/.agents/skills/ak-release/
!/.agents/skills/ak-resume/
!/.agents/skills/ak-ship/
!/.agents/skills/ak-upstream-file/
!/.agents/skills/ak-upstream-status/
!/.agents/skills/ak-verify/
!/.agents/skills/ak-worktree-sweep/
.codex/
.mcp.json
# ak's receipts and backups beside the gitignored .mcp.json (AQE pin: aqe-project-pin.mjs;
# AQE embedding: aqe-embedding-projection.mjs). The ones beside .claude/ and .codex/ files
# are already covered by those folders.
.mcp.json.agentic-kit-aqe-pin.json
.mcp.json.ak-aqe-pin-backup.*
.mcp.json.agentic-kit-aqe-embedding.json
.mcp.json.ak-aqe-backup.*
ruvector.db
*.db
CLAUDE.md.backup
CLAUDE.md.pre-ruflo

# RVF pattern stores + locks are derived runtime caches (rebuilt from memory.db);
# ruflo/aqe processes can drop them in cwd (e.g. `ruflo mcp start`), and an
# interrupted write leaves a corrupt FLVR-content .lock (see _ruflo_aqe_repair_rvf).
*.rvf
*.rvf.lock
*.rvf.idmap.json
*.rvf.manifest.json

# package-manager artifacts (repo is zero-dependency; lockfile IS tracked)
node_modules/

# superpowers brainstorm mockups (local only)
.superpowers/

# UI verification screenshots (regenerated by pnpm test:ui)
.ui-artifacts/

# Claude Code local config
CLAUDE.local.md

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
